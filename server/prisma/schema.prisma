generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
// extensions = [vector]
}

enum Role {
  SUPER_ADMIN
  ADMIN
  ASST_CHIEF_CONVENOR
  DEPT_CONVENOR
  DEPT_ASST_CONVENOR
  COORDINATOR
  MEMBER
}

enum ApprovalStatus {
  ACTIVE
  PENDING_DEPT_REVIEW
  PENDING_ASST_CHIEF_REVIEW
  REJECTED
}

enum EventStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id              String         @id @default(uuid())
  name            String
  email           String         @unique
  password        String
  rollNumber      String?        @unique
  branch          String?        // Academic branch/major (e.g., CSE, ECE)
  semester        Int?
  module          String?        // Academic module
  contactNumber   String?
  role            Role           @default(MEMBER)
  approvalStatus  ApprovalStatus @default(ACTIVE)
  departmentId    String?
  department      Department?    @relation("DepartmentMembers", fields: [departmentId], references: [id])
  addedBy         String?
  addedByUser     User?          @relation("AddedByUser", fields: [addedBy], references: [id])
  addedUsers      User[]         @relation("AddedByUser")
  refreshToken    String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relations
  // faceEmbeddings   FaceEmbedding[]
  approvalRequests ApprovalRequest[] @relation("ApplicantRequests")
  deptReviews      ApprovalRequest[] @relation("DeptReviewer")
  chiefReviews     ApprovalRequest[] @relation("ChiefReviewer")
  createdEvents    Event[]           @relation("EventCreator")
  attendances      Attendance[]
  auditLogsActor   AuditLog[]        @relation("AuditActor")

  @@map("users")
}

model Department {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members          User[]            @relation("DepartmentMembers")
  approvalRequests ApprovalRequest[]

  @@map("departments")
}

model ApprovalRequest {
  id           String @id @default(uuid())
  userId       String
  user         User   @relation("ApplicantRequests", fields: [userId], references: [id])
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  // Stage 1: Department Convenor review
  deptReviewStatus   ReviewStatus @default(PENDING)
  deptReviewedBy     String?
  deptReviewer       User?        @relation("DeptReviewer", fields: [deptReviewedBy], references: [id])
  deptReviewedAt     DateTime?
  deptRemarks        String?

  // Stage 2: Assistant Chief Convenor review
  asstChiefReviewStatus ReviewStatus @default(PENDING)
  asstChiefReviewedBy   String?
  asstChiefReviewer     User?        @relation("ChiefReviewer", fields: [asstChiefReviewedBy], references: [id])
  asstChiefReviewedAt   DateTime?
  asstChiefRemarks      String?

  finalStatus ApprovalStatus @default(PENDING_DEPT_REVIEW)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("approval_requests")
}

