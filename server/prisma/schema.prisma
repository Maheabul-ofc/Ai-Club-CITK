model Event {
  id        String      @id @default(uuid())
  title     String
  date      DateTime
  time      String
  status    EventStatus @default(SCHEDULED)
  createdBy String
  creator   User        @relation("EventCreator", fields: [createdBy], references: [id])
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  attendances Attendance[]

  @@map("events")
}

model Attendance {
  id              String   @id @default(uuid())
  eventId         String
  event           Event    @relation(fields: [eventId], references: [id])
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  timestamp       DateTime @default(now())
  confidenceScore Float?
  markedManually  Boolean  @default(false)

  @@unique([eventId, userId])
  @@map("attendances")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  actor      User     @relation("AuditActor", fields: [actorId], references: [id])
  action     String   // e.g., 'CREATE_ADMIN', 'DELETE_ADMIN', 'ADD_TEAM_MEMBER', 'APPROVE_COORDINATOR'
  targetType String   // e.g., 'User', 'Department', 'Event'
  targetId   String
  details    Json?
  createdAt  DateTime @default(now())

  @@map("audit_logs")
}

model LeadershipProfile {
  id           String   @id @default(uuid())
  name         String
  role         String
  photoUrl     String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("leadership_profiles")
}
